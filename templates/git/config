[user]
    name = {{ .Name }}
    email = {{ .PersonalEmail }}
{{ range .Orgs }}
[includeIf "hasconfig:remote.*.url:*{{ .Host }}:{{ .Name }}/**"]
    path = {{ $.Home }}/.gitconfig-org-{{ .Name }}
[includeIf "hasconfig:remote.*.url:*://{{ .Host }}/{{ .Name }}/**"]
    path = {{ $.Home }}/.gitconfig-org-{{ .Name }}
{{ end }}
[core]
    hooksPath = ~/.config/git/hooks

[init]
    defaultBranch = main

# Settings of the profile chosen in ~/.config/dotfiles/config.toml (managed,
# empty without a profile).
[include]
    path = ~/.config/git/profile
